  "description": "Healthcare OS API — multi-tenant commerce, supply chain & verification",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "create_module": "ts-node src/create-feature.ts",
    "watch": "tsc --watch",
    "server": "nodemon dist/main.js",
    "seed": "ts-node src/seed/seed_db.ts",
    "seed:rbac": "ts-node src/seed/seed-rbac.ts",
    "seed:demo": "ts-node src/seed/seed-demo.ts",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:full": "docker compose --profile full up -d --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
