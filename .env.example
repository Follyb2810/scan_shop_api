# =============================================================================
# Healthcare OS API — run the app on your machine; Docker = Postgres + Redis only
#
#   npm run docker:up   # exposes Postgres :5432 and Redis :6379 on localhost
#   npm run dev         # API locally — errors print in this terminal
# =============================================================================

NODE_ENV=development
PORT=5000
APP_NAME=healthcare-os-api
APP_URL=http://localhost:5000

# --- Docker Postgres via localhost (not "postgres" hostname) ---
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_os?schema=public

# --- SQLite (commented out — optional local file DB) ---
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./dev.db

# --- Docker Redis via localhost ---
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Seed catalogs + demo users/orgs on every boot (idempotent).
# Defaults to true when NODE_ENV=development.
AUTO_SEED_DEMO=true

# Auth secrets (change in any shared/non-local environment)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HMAC_SECRET=dev-hmac-secret-change-me-32chars
HMAC_KEY_ID=v1
PLATFORM_ID=healthcare-os
BCRYPT_ROUNDS=10

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
