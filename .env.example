# =============================================================================
# Healthcare OS API — environment
# Development uses SQLite. Postgres + Redis are available via Docker Compose.
# =============================================================================

NODE_ENV=development
PORT=5000
APP_NAME=healthcare-os-api
APP_URL=http://localhost:5000

# --- Database (development default: SQLite) ---
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# When switching to Docker Postgres later:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_os?schema=public

# --- Redis (docker compose: npm run docker:up) ---
# Keep false for SQLite-only local boot. Set true when Redis is running.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Auth secrets (change in any shared/non-local environment)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HMAC_SECRET=dev-hmac-secret-change-me-32chars
HMAC_KEY_ID=v1
PLATFORM_ID=healthcare-os
BCRYPT_ROUNDS=10

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info
